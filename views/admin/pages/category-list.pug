extends ../layouts/default.pug

block main
  if(roleDetail.permissions.includes('category-view'))
    h1.box-title Quản lý danh mục

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item.inner-label
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(filter-status)
            option(value="" ) Trạng thái
            option(value="active") Hoạt động
            option(value="inactive") Tạm dừng
        .inner-item
          select(filter-created-by)
            option(value= "" ) Người tạo
            each item in accountAdminList
              option(value= item.id ) #{item.fullName}
        .inner-item.inner-date
          input(type="date" filter-start-date)
          span -
          input(type="date" filter-end-date)
        .inner-item.inner-reset(filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        .inner-change-status(
          change-multi
          data-api=`/${pathAdmin}/category/change-multi`
        )
          .inner-item
            select()
              option(value="") -- Hành động --
              if(roleDetail.permissions.includes('category-edit'))
                option(value="active") Hoạt động
                option(value="inactive") Dừng hoạt động
              if(roleDetail.permissions.includes('category-delete'))
                option(value="delete") Xóa
          .inner-item
            button( data-api= `/${pathAdmin}/category/change-multi`) Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search-text)
        if(roleDetail.permissions.includes('category-create'))
          .inner-button-create
            a(
              href=`/${pathAdmin}/category/create`
            ) + Tạo mới
        if(roleDetail.permissions.includes('category-delete'))
          .inner-button-trash
            a(
              href=`/${pathAdmin}/category/trash`
            ) Thùng rác
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tên danh mục
              th Ảnh đại diện
              th(class="inner-center") Vị trí
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Cập nhật bởi
              th Hành động
          tbody
              each item in categoryList
                tr
                  td(class="inner-center")
                    input(type="checkbox" class="inner-check" check-item=item.id)
                  td #{item.name}
                  td
                    img(src= item.avatar class="inner-avatar")
                  td(class="inner-center") #{item.position}
                  td(class="inner-center")
                    if (item.status == "active")
                      .badge.badge-green Hoạt động
                    else if (item.status == "inactive")
                      .badge.badge-red Tạm dừng
                  td
                    div #{item.createdByFullName}
                    div.inner-time #{item.createdAtFormat}
                  td
                    div #{item.updatedByFullName}
                    div.inner-time #{item.updatedAtFormat}
                  td
                    .inner-buttons
                      if(roleDetail.permissions.includes('category-edit'))
                        a(
                          href=`/${pathAdmin}/category/edit/${item.id}`
                          class="inner-edit"
                        ) <i class="fa-regular fa-pen-to-square"></i>
                      if(roleDetail.permissions.includes('category-delete'))
                        button(
                          class="inner-delete"
                          button-delete
                          data-api = `/${pathAdmin}/category/delete/${item.id}`
                        ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7
      // phải sử dụng categoryList.length để có thể bắt chính xác trong TH page có 1 item hoặc không đủ limit của trang để có thể 
      // hiển thị chính xác hơn
      span(class="inner-label") Hiển thị #{pagination.skip + 1} - #{pagination.skip + categoryList.length} của #{pagination.totalRecord}
      select(class="inner-pagination" pagination)
        - for(let i = 1;i <= pagination.limitPage;i++){ 
            option(value=i) Trang #{i} 
        - }
    //- End Section 7