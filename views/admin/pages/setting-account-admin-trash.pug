extends ../layouts/default.pug

block main
  if(roleDetail.permissions.includes('account-admin-delete'))

    h1.box-title Thùng rác  

    //- Section 5
    .section-5
      .inner-wrap
        .inner-change-status(change-multi)
          .inner-item
            select
              option(value="") -- Hành động --
              option(value="undo") Khôi phục
              option(value="delete-destroy") Xóa vĩnh viễn
          .inner-item
            button(data-api=`/${pathAdmin}/setting/account-admin/trash/change-mutli`) Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search-text)
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Họ tên
              th(class="inner-center") Ảnh đại diện
              th Email
              th Số điện thoại
              th Nhóm quyền
              th Chức vụ
              th Trạng thái
              th Hành động
          tbody
            each item in AccountAdminList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.fullName}
                td(class="inner-center")
                  img(src=item.avatar class="inner-avatar")
                td #{item.email}
                td #{item.phone}
                td #{item.nameRole}
                td #{item.positionCompany}
                td
                  if (item.status == "active")
                    .badge.badge-green Hoạt động
                  else if(item.status =="inactive")
                    .badge.badge-red Tạm dừng
                  else if(item.status =="initial")
                    .badge.badge-orange Khởi tạo
                td
                  .inner-buttons
                    button(class="inner-undo" button-undo data-api=`/${pathAdmin}/setting/account-admin/undo/${item.id}`) <i class="fa-solid fa-rotate-left"></i>
                    button(class="inner-delete" button-delete data-api=`/${pathAdmin}/setting/account-admin/delete-destroy/${item.id}`) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7
      span(class="inner-label") Hiển thị #{pagination.skip + 1} - #{pagination.skip + AccountAdminList.length} của #{pagination.totalRecord}
      select(class="inner-pagination" pagination)
        - for(let i = 1;i <= pagination.limitPage;i++){
            option(value=i) Trang #{i}
        - }
    //- End Section 7