extends ../layouts/default.pug

block main
  if(roleDetail.permissions.includes('role-view'))
    h1.box-title Nhóm quyền

    //- Section 5
    .section-5
      .inner-wrap(change-multi)
        .inner-change-status
          .inner-item
            select
              option(value="") -- Hành động --
              if(roleDetail.permissions.includes('role-delete'))
                option(value="delete") Xóa
          .inner-item
            button(data-api=`/${pathAdmin}/setting/role/change-multi`) Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search-text)
        if(roleDetail.permissions.includes('role-create'))
          .inner-button-create
            a(href=`/${pathAdmin}/setting/role/create`)  + Tạo mới
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tên nhóm quyền
              th Mô tả ngắn
              th Hành động
          tbody
            each item in roleList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.name}
                td #{item.description}
                td
                  .inner-buttons
                    if(roleDetail.permissions.includes('role-edit'))
                      a(class="inner-edit" href=`/${pathAdmin}/setting/role/edit/${item.id}`)
                        <i class="fa-regular fa-pen-to-square"></i>
                    if(roleDetail.permissions.includes('role-delete'))
                      button(class="inner-delete" button-delete data-api=`/${pathAdmin}/setting/role/delete/${item.id}`) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6